# Optional local provider credentials for automated research-only source ladders.
# Copy this file to config/provider_keys.env or .env, fill only the providers you use,
# and keep the real key file untracked.

# SEC staging requires an identifying User-Agent.
SEC_USER_AGENT="Your Name your.email@example.com"

# Price fallback:
# - Yahoo chart is tried without a key.
# - Stooq may work without a key in some environments, but keyed access is supported.
STOOQ_API_KEY=

# Fundamentals/share-count and price fallback providers:
# If project-status says source-proof queues are exhausted, configure only one
# keyed free-tier provider first. The current recommended first provider is FMP.
# After adding a key, rerun `make session-source-preflight`, then use the
# provider's reviewed one-ticker smoke command before any broader batch.
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# IBKR is optional read-only daily OHLCV and disabled by default.
# Leave these blank unless you intentionally run IBKR Gateway/TWS for local market data.
# No broker trading, account actions, order routing, or auto-trading.
IBKR_HOST=
IBKR_PORT=
IBKR_CLIENT_ID=
