# Optional hosted-demo URL marker.
# Copy this file to config/hosted_demo.env only after a public hosted app exists.
# Keep the real local marker untracked, then run make hosted-demo-readiness.
#
# A configured URL is not proof by itself. Before changing README, LinkedIn, or
# portfolio copy, open the hosted public route and rerun public gates.
HOSTED_DEMO_URL=

# Public hosting must use the compact, tracked snapshot rather than local refresh data.
STOCK_RESEARCH_DATA_PROFILE=demo
